# Discord Developer Portal > Bot > Token (ne jamais publier)
DISCORD_TOKEN=
# Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=
# Facultatif : un serveur de test, commandes disponibles immédiatement
DISCORD_GUILD_ID=
# Railway : référence à la variable du service PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terre_des_noobs
# true enregistre les commandes au démarrage seulement si leur définition change
REGISTER_COMMANDS=true
PORT=3000
# Local uniquement : true démarre un bot sans sauvegarde persistante
DEMO_MODE=false
