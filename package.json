{
  "name": "terre-des-noobs",
  "version": "1.0.0",
  "private": true,
  "description": "RPG Discord social en français — les Chroniques de Brumeterre",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "register": "node --env-file-if-exists=.env scripts/register.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "preview": "node scripts/preview.js",
    "test:postgres": "node --env-file-if-exists=.env --test test/postgres.test.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "discord.js": "14.27.0",
    "pg": "8.23.1"
  }
}
