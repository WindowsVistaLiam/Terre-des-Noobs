{
  "name": "terre-des-noobs",
  "version": "2.0.0",
  "private": true,
  "description": "Gacha Discord social de personnages manga — Manga Club",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "register": "node --env-file-if-exists=.env scripts/register.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "preview": "node scripts/preview-gacha.js",
    "preview:gacha": "node scripts/preview-gacha.js",
    "preview:animations": "node scripts/preview-animations.js",
    "catalog:import": "node scripts/import-gacha.js",
    "test:postgres": "node --env-file-if-exists=.env --test test/gacha-postgres.test.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "discord.js": "14.27.0",
    "gifenc": "1.0.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "omggif": "1.0.10"
  }
}
